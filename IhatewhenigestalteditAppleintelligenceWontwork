local function setRate(em, r)
    r = math.max(r, 0)
    if math.abs(em.Rate - r) > 2 then em.Rate = r end
    local on = r > 1
    if em.Enabled ~= on then em.Enabled = on end
end

local function apply(dt)
    local cam = Workspace.CurrentCamera
    local now = os.clock()

    if Settings.lockTime then
        if math.abs(Lighting.ClockTime - Settings.clockTime) > 0.001 then Lighting.ClockTime = Settings.clockTime end
    elseif Settings.timeSpeed > 0 then
        cycleTime = (cycleTime + dt * Settings.timeSpeed / 60) % 24
        Lighting.ClockTime = cycleTime
    end

    local tw = WEATHER[Settings.weather] or WEATHER.Clear
    for k, v in pairs(tw) do wx[k] = damp(wx[k], v, 0.8, dt) end
    local over = clamp(wx.dark * 1.5, 0, 1)

    if Settings.lightning and wx.storm > 0.5 and now >= nextBolt then
        S.flash = 1; nextBolt = now + math.random(3, 10)
        if math.random() < 0.7 then task.delay(0.12, function() S.flash = math.max(S.flash, 0.95) end) end
    end
    S.flash = damp(S.flash, 0, 11, dt)

    local sunY = Lighting:GetSunDirection().Y
    local dayF = smoothstep(-0.10, 0.28, sunY)
    local gt = clamp(1 - math.abs(sunY - 0.10) / 0.26, 0, 1)
    local g = gt * gt * (3 - 2 * gt)
    W.g = g * (1 - over); W.d = (1 - g) * dayF * (1 - over); W.n = (1 - g) * (1 - dayF) * (1 - over); W.r = over

    S.indoor = damp(S.indoor, S.indoorT, 4.0, dt); S.sunF = damp(S.sunF, S.sunFT, 6.5, dt)
    S.sunDisk = damp(S.sunDisk, S.sunDiskT, 8.0, dt); S.focus = damp(S.focus, S.focusT, CFG.FOCUS_SPEED, dt)
    S.water = damp(S.water, S.waterT, 8.5, dt); S.ssao = damp(S.ssao, S.ssaoT, 7.0, dt)
    S.neonR = damp(S.neonR, S.neonRT, 4.5, dt); S.neonG = damp(S.neonG, S.neonGT, 4.5, dt); S.neonB = damp(S.neonB, S.neonBT, 4.5, dt)
    S.mblur = damp(S.mblur, motionBlurTarget(dt), 16, dt); S.speed = damp(S.speed, S.speedT or 0, 5, dt)

    local indoor, water, flash = S.indoor, S.water, S.flash
    local cloudCut = 1 - over * 0.75
    local sunF = S.sunF * (1 - indoor) * (1 - water) * cloudCut
    local sunDisk = S.sunDisk * (1 - indoor) * (1 - water) * cloudCut
    local neonMag, nightAmt = math.max(S.neonR, S.neonG, S.neonB), W.n

    if cam then
        local cp = cam.CFrame.Position
        rainPart.CFrame = CFrame.new(cp + V3(0, 45, 0)); snowPart.CFrame = CFrame.new(cp + V3(0, 35, 0)); dustPart.CFrame = CFrame.new(cp)
    end
    local outdoor = (1 - indoor) * (1 - water)
    setRate(rainEm, 1200 * wx.rain * outdoor)
    setRate(snowEm, 700 * wx.snow * outdoor)
    snowEm.Acceleration = V3(math.sin(now * 0.7) * 8, 0, math.cos(now * 0.5) * 6)
    setRate(dustEm, (Settings.dust and state.enabled) and (25 * (1 - wx.rain) * (1 - wx.snow) * (0.5 + sunF)) or 0)

    local sk = SKY[Settings.skyStyle] or SKY.Default
    local ska = sk.amt * (1 - over * 0.3)
    local ambientFinal = bc(P.Ambient)
    if neonMag > 0.001 then ambientFinal = lerpC3(ambientFinal, Color3.new(S.neonR, S.neonG, S.neonB), neonMag * (0.50 + nightAmt * 0.40)) end
    if flash > 0.01 then ambientFinal = lerpC3(ambientFinal, C3(220, 230, 255), flash * 0.7) end
    local darkBase = lerpC3(ambientFinal, C3(0, 0, 0), S.ssao * 1.3)
    local breath = math.sin(now * 1.5) * 0.03 * sunDisk
    local gr = GRADES[Settings.grade] or GRADES.Cinematic

    setN(Lighting, "Brightness", bn(P.Brightness) * (1 - indoor * 0.10) + flash * 2.0)
    setN(Lighting, "ExposureCompensation", bn(P.Exposure) + indoor * CFG.INDOOR_EXPOSURE - sunF * 0.35 + breath + Settings.exposure + flash * 0.8)
    setC(Lighting, "Ambient", darkBase); setC(Lighting, "OutdoorAmbient", bc(P.Outdoor))
    local top = bc(P.ShiftTop); if sk.top then top = lerpC3(top, sk.top, ska) end
    setC(Lighting, "ColorShift_Top", top); setC(Lighting, "ColorShift_Bottom", bc(P.ShiftBottom))
    
    local refl = (REFLECT_MULT[Settings.reflections] or 1) * 1.8
    local spec = clamp(refl + wx.rain * 0.8 + wx.snow * 0.4, 0, 3)
    setN(Lighting, "EnvironmentSpecularScale", spec); setN(Lighting, "EnvironmentDiffuseScale", refl * 1.2)

    local waterCol = C3(20, 90, 130)
    local glarePulse = 1 + math.sin(now * 0.7) * 0.08 * sunDisk
    local fogMult = Settings.fog == "Off" and 0 or qual("fog")
    local ac, ad = bc(P.AtmoColor), bc(P.AtmoDecay)
    if sk.atmo then ac = lerpC3(ac, sk.atmo, ska); ad = lerpC3(ad, sk.decay, ska) end
    setN(atmo, "Density", lerp(clamp(bn(P.AtmoDensity) * fogMult + wx.fog * 0.40, 0, 0.98), 0.82, water))
    setN(atmo, "Offset", bn(P.AtmoOffset))
    setC(atmo, "Color", lerpC3(ac, waterCol, water)); setC(atmo, "Decay", lerpC3(ad, C3(10, 40, 60), water))
    setN(atmo, "Glare", clamp((bn(P.AtmoGlare) + sunF * CFG.SUN_GLARE_EXTRA) * glarePulse, 0, 1))
    setN(atmo, "Haze", lerp(bn(P.AtmoHaze) * fogMult + wx.fog * 5, 12, water))

    local fogEnd = math.min(bn(P.FogDist), FOG_END[Settings.fog] or 600) * (1 - wx.fog * 0.60 - wx.rain * 0.20)
    fogEnd = lerp(fogEnd, 90, water)
    local fc = bc(P.FogColor); if sk.fog then fc = lerpC3(fc, sk.fog, ska) end
    setN(Lighting, "FogEnd", fogEnd); setN(Lighting, "FogStart", fogEnd * 0.20)
    setC(Lighting, "FogColor", lerpC3(fc, waterCol, water * 0.8))

    local clar = qual("clarity") * 1.5
    local sat = bn(P.Sat) * qual("colorgrade") + gr.sat + water * 0.18 + neonMag * (0.10 + nightAmt * 0.08) - sunDisk * 0.06 + clar * 0.05
    local contrast = bn(P.Contrast) * qual("contrast") + gr.con + S.ssao * 0.08 + sunDisk * 0.05 + clar * 0.08
    local tint = lerpC3(bc(P.Tint), C3(100, 165, 210), water)
    tint = lerpC3(tint, gr.tint, gr.amt)
    if neonMag > 0.001 then
        tint = lerpC3(tint, Color3.new(lerp(1, S.neonR, neonMag * 0.6), lerp(1, S.neonG, neonMag * 0.6), lerp(1, S.neonB, neonMag * 0.6)), neonMag * 0.35)
    end
    if sunDisk > 0.01 then tint = lerpC3(tint, C3(255, 225, 190), sunDisk * 0.15) end
    if Settings.warmth > 0.01 then tint = lerpC3(tint, C3(255, 195, 140), Settings.warmth * 0.45)
    elseif Settings.warmth < -0.01 then tint = lerpC3(tint, C3(140, 185, 255), -Settings.warmth * 0.45) end
    setN(cc, "Saturation", clamp(sat, -1, 1.5)); setN(cc, "Contrast", clamp(contrast, -1, 1.5))
    setN(cc, "Brightness", bn(P.Brightness2) + gr.bri + sunDisk * 0.03); setC(cc, "TintColor", tint)

    local bloomI = (bn(P.BloomI) + sunF * CFG.SUN_BLOOM_EXTRA + sunDisk * CFG.SUN_DISK_BLOOM + sunF * 0.50 + neonMag * nightAmt * 0.50 + flash * 1.8) * qual("bloom")
    setN(bloom, "Intensity", clamp(bloomI, 0, 5.0)); setN(bloom, "Threshold", bn(P.BloomT) - sunF * 0.18 - sunDisk * 0.10)
    setN(bloom, "Size", lerp(56, 96, sunF) + sunDisk * 32)
    setN(sunRays, "Intensity", clamp((bn(P.RaysI) + sunF * CFG.SUN_RAYS_EXTRA + sunDisk * CFG.SUN_DISK_RAYS) * (1 - indoor * 0.75) * (1 - water) * qual("sunrays"), 0, 1.8))

    if dof.Enabled ~= S.dofOn then dof.Enabled = S.dofOn end
    if S.dofOn then
        local dm = clamp(qual("dof"), 0, 2.0)
        setN(dof, "FocusDistance", S.focus); setN(dof, "InFocusRadius", clamp(S.focus * 0.35, 8, 140) * (1 - sunDisk * 0.40))
        setN(dof, "FarIntensity", clamp(0.60 * dm * (1 - water * 0.45) + sunDisk * 0.15, 0, 1))
        setN(dof, "NearIntensity", clamp(0.18 * dm + sunDisk * 0.08, 0, 1))
    end
    setN(blur, "Size", math.max(water * 18, S.mblur))

    if clouds and clouds.Parent and clouds.Enabled then
        local cm = math.min((QM[Settings.clouds] or 1) * 1.4, 2.0)
        setN(clouds, "Cover", clamp(0.55 * cm + wx.cover * 0.55, 0, 1)); setN(clouds, "Density", clamp(0.75 * cm + wx.cover * 0.40, 0, 1))
        local cc2 = bc(P.CloudColor); if sk.cloud then cc2 = lerpC3(cc2, sk.cloud, ska) end
        setC(clouds, "Color", cc2)
    end
    setVignette(qual("vignette") * 0.40 * (0.80 + indoor * 0.40 + nightAmt * 0.25 + over * 0.20))

    if cam and (Settings.customFov or Settings.dynFov) then
        local base = Settings.customFov and Settings.fov or origFov
        local want = base + (Settings.dynFov and clamp(S.speed - 16, 0, 40) * 0.18 or 0)
        if math.abs(cam.FieldOfView - want) > 0.05 then cam.FieldOfView = damp(cam.FieldOfView, want, 8, dt) end
        fovActive = true
    elseif fovActive and cam then
        cam.FieldOfView = origFov; fovActive = false
    end
end

